cat > dns_benchmark_completo.sh << 'EOF'
#!/bin/bash

# ============================================
#  DNS BENCHMARK COMPLETO - BRASIL
#  Testa 50+ servidores DNS
# ============================================

# Cores
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'
BOLD='\033[1m'

# Verificar se dnsutils está instalado
if ! command -v dig &> /dev/null; then
    echo -e "${RED}Erro: 'dig' não encontrado. Instale com: sudo apt install dnsutils${NC}"
    exit 1
fi

# Arrays de DNS organizados por categoria
declare -A DNS_SERVERS

# === BRASIL - Provedores Locais ===
DNS_SERVERS["200.175.182.139"]="GVT/Telefonica 1|Brasil"
