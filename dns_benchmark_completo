# === OPENDNS / CISCO UMBRELLA ===
DNS_SERVERS["208.67.222.222"]="OpenDNS Primary|Internacional"
DNS_SERVERS["208.67.220.220"]="OpenDNS Secondary|Internacional"
DNS_SERVERS["208.67.222.123"]="OpenDNS FamilyShield|Família"

# === ADGUARD ===
DNS_SERVERS["94.140.14.14"]="AdGuard Primary|Bloqueio Ads"
DNS_SERVERS["94.140.15.15"]="AdGuard Secondary|Bloqueio Ads"
DNS_SERVERS["94.140.14.15"]="AdGuard Family|Família"

# === CLEANBROWSING ===
DNS_SERVERS["185.228.168.9"]="CleanBrowsing Security|Segurança"
DNS_SERVERS["185.228.169.9"]="CleanBrowsing Security 2|Segurança"
DNS_SERVERS["185.228.168.10"]="CleanBrowsing Family|Família"
DNS_SERVERS["185.228.168.168"]="CleanBrowsing Adult|Adulto"

# === COMODO SECURE ===
DNS_SERVERS["8.26.56.26"]="Comodo Secure 1|Segurança"
DNS_SERVERS["8.20.247.20"]="Comodo Secure 2|Segurança"

# === NEXTDNS ===
DNS_SERVERS["45.90.28.0"]="NextDNS Primary|Privacidade"
DNS_SERVERS["45.90.30.0"]="NextDNS Secondary|Privacidade"

# === CONTROL D ===
DNS_SERVERS["76.76.2.0"]="ControlD Primary|Privacidade"
DNS_SERVERS["76.76.10.0"]="ControlD Secondary|Privacidade"

# === MULLVAD (Privacidade) ===
DNS_SERVERS["194.242.2.2"]="Mullvad DNS|Privacidade"

# === DNS.WATCH (Sem logs) ===
DNS_SERVERS["84.200.69.80"]="DNS.Watch 1|Privacidade"
DNS_SERVERS["84.200.70.40"]="DNS.Watch 2|Privacidade"

# === VERISIGN ===
DNS_SERVERS["64.6.64.6"]="Verisign 1|Internacional"
DNS_SERVERS["64.6.65.6"]="Verisign 2|Internacional"

# === ORACLE/DYN ===
DNS_SERVERS["216.146.35.35"]="Oracle/Dyn 1|Internacional"
DNS_SERVERS["216.146.36.36"]="Oracle/Dyn 2|Internacional"

# === NTT ===
DNS_SERVERS["129.250.35.250"]="NTT 1|Internacional"
DNS_SERVERS["129.250.35.251"]="NTT 2|Internacional"

# === HURRICANE ELECTRIC ===
DNS_SERVERS["74.82.42.42"]="Hurricane Electric|Internacional"

# === AMÉRICA LATINA ===
DNS_SERVERS["200.40.30.245"]="Antel Uruguay|LATAM"
DNS_SERVERS["200.35.74.82"]="Argentina CABASE|LATAM"

# Domínios para teste (sites populares)
DOMAINS=(
    "google.com"
    "facebook.com"
    "youtube.com"
    "amazon.com"
    "github.com"
    "netflix.com"
    "twitter.com"
    "instagram.com"
    "linkedin.com"
    "reddit.com"
    "globo.com"
    "uol.com.br"
    "mercadolivre.com.br"
)

# Número de testes por domínio
TESTS_PER_DOMAIN=3

# Timeout em segundos
TIMEOUT=2

# Arquivo de resultados
RESULTS_FILE="dns_benchmark_results_$(date +%Y%m%d_%H%M%S).txt"

# Função para exibir cabeçalho
print_header() {
    clear
    echo -e "${CYAN}"
    echo "╔══════════════════════════════════════════════════════════════════════╗"
    echo "║                                                                      ║"
    echo "║           🌐 DNS BENCHMARK COMPLETO - BRASIL 🇧🇷                      ║"
    echo "║                                                                      ║"
    echo "║  Testando ${#DNS_SERVERS[@]} servidores DNS com ${#DOMAINS[@]} domínios                        ║"
    echo "║  Data: $(date '+%Y-%m-%d %H:%M:%S')                                       ║"
    echo "║                                                                      ║"
    echo "╚══════════════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

# Função para testar um DNS
test_dns() {
    local dns=$1
    local total=0
    local success=0
    local min=99999
    local max=0
    local times=()
    
    for domain in "${DOMAINS[@]}"; do
        for ((i=1; i<=TESTS_PER_DOMAIN; i++)); do
            # Executa dig e captura tempo
            result=$(dig @"$dns" "$domain" +tries=1 +time=$TIMEOUT 2>/dev/null)
            time=$(echo "$result" | grep "Query time:" | awk '{print $4}')
            
            if [ -n "$time" ] && [ "$time" -ge 0 ] 2>/dev/null; then
                times+=("$time")
                total=$((total + time))
                success=$((success + 1))
                [ "$time" -lt "$min" ] && min=$time
                [ "$time" -gt "$max" ] && max=$time
            fi
        done
    done
    
    if [ $success -gt 0 ]; then
        avg=$((total / success))
        
        # Calcular desvio padrão
        local sum_sq=0
        for t in "${times[@]}"; do
            diff=$((t - avg))
            sum_sq=$((sum_sq + diff * diff))
        done
        stddev=$(echo "scale=2; sqrt($sum_sq / $success)" | bc 2>/dev/null || echo "0")
        
        echo "$avg|$min|$max|$stddev|$success"
    else
        echo "FAIL|0|0|0|0"
    fi
}

# Função principal
main() {
    print_header
    
    echo -e "${YELLOW}⏳ Iniciando benchmark... Isso pode levar alguns minutos.${NC}"
    echo ""
    
    # Arrays para armazenar resultados
    declare -A RESULTS
    declare -A RESULTS_FULL
    
    local total_dns=${#DNS_SERVERS[@]}
    local current=0
    
    # Testar cada DNS
    for dns in "${!DNS_SERVERS[@]}"; do
        current=$((current + 1))
        IFS='|' read -r name category <<< "${DNS_SERVERS[$dns]}"
        
        # Progress bar
        pct=$((current * 100 / total_dns))
        printf "\r${CYAN}[%3d%%]${NC} Testando: %-25s %-20s" "$pct" "$name" "($dns)"
        
        result=$(test_dns "$dns")
        IFS='|' read -r avg min max stddev success <<< "$result"
        
        if [ "$avg" != "FAIL" ]; then
            RESULTS[$dns]=$avg
            RESULTS_FULL[$dns]="$avg|$min|$max|$stddev|$success|$name|$category"
        else
            RESULTS_FULL[$dns]="FAIL|0|0|0|0|$name|$category"
        fi
    done
    
    echo ""
    echo ""
    
    # Ordenar resultados
    echo -e "${CYAN}══════════════════════════════════════════════════════════════════════${NC}"
    echo -e "${BOLD}${GREEN}📊 RESULTADOS DO BENCHMARK (ordenado por velocidade)${NC}"
    echo -e "${CYAN}══════════════════════════════════════════════════════════════════════${NC}"
    echo ""
    
    printf "${BOLD}%-4s %-18s %-25s %-12s %6s %6s %6s %6s %6s${NC}\n" \
        "#" "IP" "NOME" "CATEGORIA" "AVG" "MIN" "MAX" "STDEV" "OK"
    echo "──────────────────────────────────────────────────────────────────────────────────────────"
    
    # Salvar cabeçalho no arquivo
    {
        echo "DNS BENCHMARK - $(date)"
        echo "======================================"
        printf "%-4s %-18s %-25s %-12s %6s %6s %6s %6s %6s\n" \
            "#" "IP" "NOME" "CATEGORIA" "AVG" "MIN" "MAX" "STDEV" "OK"
        echo "──────────────────────────────────────────────────────────────────────────────────────────"
    } > "$RESULTS_FILE"
    
    # Ordenar e exibir
    local rank=1
    for dns in $(for key in "${!RESULTS[@]}"; do echo "$key ${RESULTS[$key]}"; done | sort -k2 -n | awk '{print $1}'); do
        IFS='|' read -r avg min max stddev success name category <<< "${RESULTS_FULL[$dns]}"
        
        # Cor baseada na latência
        if [ "$avg" -lt 15 ]; then
            color=$GREEN
            medal="🥇"
        elif [ "$avg" -lt 30 ]; then
            color=$CYAN
            medal="🥈"
        elif [ "$avg" -lt 50 ]; then
            color=$YELLOW
            medal="🥉"
        else
            color=$RED
            medal="  "
        fi
        
        printf "${color}%-4s %-18s %-25s %-12s %5dms %5dms %5dms %6.1f %5d${NC}\n" \
            "$medal$rank" "$dns" "$name" "$category" "$avg" "$min" "$max" "$stddev" "$success"
        
        # Salvar no arquivo
        printf "%-4s %-18s %-25s %-12s %5dms %5dms %5dms %6.1f %5d\n" \
            "$rank" "$dns" "$name" "$category" "$avg" "$min" "$max" "$stddev" "$success" >> "$RESULTS_FILE"
        
        rank=$((rank + 1))
    done
    
    # Mostrar DNS que falharam
    echo ""
    echo -e "${RED}❌ DNS que falharam ou tiveram timeout:${NC}"
    for dns in "${!RESULTS_FULL[@]}"; do
        IFS='|' read -r avg min max stddev success name category <<< "${RESULTS_FULL[$dns]}"
        if [ "$avg" == "FAIL" ]; then
            echo -e "   ${RED}$dns ($name)${NC}"
        fi
    done
    
    echo ""
    echo -e "${CYAN}══════════════════════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}✅ Benchmark concluído! Resultados salvos em: ${BOLD}$RESULTS_FILE${NC}"
    echo -e "${CYAN}══════════════════════════════════════════════════════════════════════${NC}"
    echo ""
    
    # Recomendações
    echo -e "${YELLOW}💡 RECOMENDAÇÃO PARA ADGUARD HOME:${NC}"
    echo ""
    
    # Pegar os 4 melhores
    echo -e "${GREEN}Servidores DNS Primários (os 4 mais rápidos):${NC}"
    rank=1
    for dns in $(for key in "${!RESULTS[@]}"; do echo "$key ${RESULTS[$key]}"; done | sort -k2 -n | head -4 | awk '{print $1}'); do
        IFS='|' read -r avg min max stddev success name category <<< "${RESULTS_FULL[$dns]}"
        echo "   $dns    # $name ($avg ms)"
        rank=$((rank + 1))
    done
    
    echo ""
    echo -e "${CYAN}Servidores DNS Fallback (próximos 3):${NC}"
    rank=1
    for dns in $(for key in "${!RESULTS[@]}"; do echo "$key ${RESULTS[$key]}"; done | sort -k2 -n | tail -n +5 | head -3 | awk '{print $1}'); do
        IFS='|' read -r avg min max stddev success name category <<< "${RESULTS_FULL[$dns]}"
        echo "   $dns    # $name ($avg ms)"
        rank=$((rank + 1))
    done
    
    echo ""
}

# Executar
main
EOF

chmod +x dns_benchmark_completo.sh
./dns_benchmark_completo.sh
