DNS_SERVERS["200.149.55.141"]="Embratel 2|Brasil"
DNS_SERVERS["181.213.132.2"]="Claro/NET 1|Brasil"
DNS_SERVERS["181.213.132.3"]="Claro/NET 2|Brasil"

# === CLOUDFLARE ===
DNS_SERVERS["1.1.1.1"]="Cloudflare Primary|Internacional"
DNS_SERVERS["1.0.0.1"]="Cloudflare Secondary|Internacional"
DNS_SERVERS["1.1.1.2"]="Cloudflare Malware Block|Internacional"
DNS_SERVERS["1.1.1.3"]="Cloudflare Family|Internacional"

# === GOOGLE ===
DNS_SERVERS["8.8.8.8"]="Google Primary|Internacional"
DNS_SERVERS["8.8.4.4"]="Google Secondary|Internacional"

# === QUAD9 (Segurança) ===
DNS_SERVERS["9.9.9.9"]="Quad9 Primary|Segurança"
DNS_SERVERS["149.112.112.112"]="Quad9 Secondary|Segurança"
DNS_SERVERS["9.9.9.10"]="Quad9 No-Filter|Segurança"
